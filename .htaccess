# Hostinger (LiteSpeed/Apache) configuration for the static KreativID site.

RewriteEngine On

# Force HTTPS and the bare domain.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kreativid.com%{REQUEST_URI} [L,R=301]

# Unknown paths fall back to the home page.
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
	# Built assets have hashed file names (e.g. index-DJ1V6Iik.css), so they can be cached forever.
	<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
